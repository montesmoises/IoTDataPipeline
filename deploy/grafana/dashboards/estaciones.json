    {
      "type": "grafana-polystat-panel",
      "title": "Estado de todas las estaciones",
      "id": 7,
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "description": "Un hexágono por estación y lado. Verde = produciendo · Azul = parada (no es falla) · Naranja = problema con el número de parte · Rojo = PLC caído o lectura incompleta. Usa el selector de arriba para filtrar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (estacion, lado) (\n    (estacion_motivo{estacion=~\"$estacion\", motivo=\"PRODUCIENDO\"} == 1) * 0\n or (estacion_motivo{estacion=~\"$estacion\", motivo=~\"CONTADOR_DETENIDO|ESTACION_SIN_PARTES\"} == 1) * 1\n or (estacion_motivo{estacion=~\"$estacion\", motivo=~\"SIN_NUMERO_PARTE|PARTE_NO_EXISTE|PARTE_OBSOLETA|MDI_SIN_RESOLVER|SIN_TAG_DE_PARTE\"} == 1) * 2\n or (estacion_motivo{estacion=~\"$estacion\", motivo=~\"PLC_DESCONECTADO|LECTURA_PARCIAL\"} == 1) * 3\n)",
          "legendFormat": "{{estacion}} {{lado}}",
          "instant": true
        }
      ],
      "options": {
        "globalShape": "hexagon_pointed_top",
        "globalOperator": "current",
        "globalDisplayMode": "all",
        "globalShowValueEnabled": false,
        "globalAutoScaleFonts": true,
        "globalLabelFontSize": 11,
        "globalValueFontSize": 12,
        "globalTextFontColor": "#FFFFFF",
        "globalTextFontAutoColorEnabled": true,
        "globalPolygonBorderSize": 2,
        "globalPolygonBorderColor": "#111217",
        "globalPolygonSize": "50",
        "globalDecimals": 0,
        "globalUnitFormat": "none",
        "globalGradientsEnabled": false,
        "globalTooltipsEnabled": true,
        "globalTooltipsShowValueEnabled": true,
        "autoSizePolygons": true,
        "autoSizeRows": true,
        "ellipseEnabled": false,
        "layoutDisplayLimit": 400,
        "layoutNumColumns": 12,
        "layoutNumRows": 6,
        "globalFillColor": "#3274D9",
        "globalThresholdsConfig": [
          {
            "color": "#37872D",
            "state": 0,
            "value": 0
          },
          {
            "color": "#3274D9",
            "state": 0,
            "value": 1
          },
          {
            "color": "#FF9830",
            "state": 1,
            "value": 2
          },
          {
            "color": "#C4162A",
            "state": 2,
            "value": 3
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Lecturas en vivo — lo que manda cada estación ahora",
      "id": 9,
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "description": "Lo que el PLC está mandando en este momento, leído con la MISMA conexión del recolector. Se llena antes de cualquier decisión: aunque la parte se rechace o el contador no avance, aquí aparece. HACE(s) subiendo = el PLC dejó de responder.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/estaciones/lecturas",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "lecturas",
          "columns": [
            {
              "selector": "estacion",
              "text": "Estación",
              "type": "string"
            },
            {
              "selector": "lado",
              "text": "Lado",
              "type": "string"
            },
            {
              "selector": "numero_plc",
              "text": "Número que manda el PLC",
              "type": "string"
            },
            {
              "selector": "numero_validado",
              "text": "Resuelto a",
              "type": "string"
            },
            {
              "selector": "contador",
              "text": "Contador",
              "type": "number"
            },
            {
              "selector": "tiempo_ciclo",
              "text": "Ciclo (s)",
              "type": "number"
            },
            {
              "selector": "troquel",
              "text": "Troquel",
              "type": "number"
            },
            {
              "selector": "error",
              "text": "Rechazo",
              "type": "string"
            },
            {
              "selector": "hace_segundos",
              "text": "Hace (s)",
              "type": "number"
            },
            {
              "selector": "area",
              "text": "Área",
              "type": "string"
            }
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hace (s)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rechazo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Contador"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Estaciones sin producción — causa clasificada",
      "id": 10,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "description": "Solo lo que requiere atención técnica. Las prensas simplemente paradas no aparecen aquí.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "/estaciones/estado?solo_problemas=1",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "estaciones",
          "columns": [
            {
              "selector": "estacion",
              "text": "Estación",
              "type": "string"
            },
            {
              "selector": "lado",
              "text": "Lado",
              "type": "string"
            },
            {
              "selector": "motivo",
              "text": "Motivo",
              "type": "string"
            },
            {
              "selector": "numero_plc",
              "text": "Número que manda el PLC",
              "type": "string"
            },
            {
              "selector": "numero_validado",
              "text": "Resuelto a",
              "type": "string"
            },
            {
              "selector": "contador",
              "text": "Contador",
              "type": "number"
            },
            {
              "selector": "segundos_sin_dato",
              "text": "Hace (s)",
              "type": "number"
            },
            {
              "selector": "area",
              "text": "Área",
              "type": "string"
            },
            {
              "selector": "ip",
              "text": "IP",
              "type": "string"
            }
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Motivo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PARTE_NO_EXISTE": {
                        "color": "orange",
                        "index": 0
                      },
                      "PARTE_OBSOLETA": {
                        "color": "purple",
                        "index": 1
                      },
                      "MDI_SIN_RESOLVER": {
                        "color": "blue",
                        "index": 2
                      },
                      "SIN_NUMERO_PARTE": {
                        "color": "blue",
                        "index": 3
                      },
                      "SIN_TAG_DE_PARTE": {
                        "color": "orange",
                        "index": 4
                      },
                      "PLC_DESCONECTADO": {
                        "color": "red",
                        "index": 5
                      },
                      "LECTURA_PARCIAL": {
                        "color": "red",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IP"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver bloque crudo del PLC",
                    "url": "http://localhost:9100/debug/plc/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estación"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver logs de esta estación",
                    "url": "/d/iot-logs?var-estacion=${__value.raw}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "estacion",
        "label": "Estación",
        "description": "Escribe para buscar. Acepta varias a la vez.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(estacion_motivo, estacion)",
        "query": {
          "query": "label_values(estacion_motivo, estacion)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  }
}